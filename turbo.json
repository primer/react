{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "generated/**"]
    },
    "build:storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "check:exports": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "check:inventory": {
      "dependsOn": [],
      "outputs": []
    },
    "check:packed-consumer": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint:client-boundaries": {
      "dependsOn": [],
      "outputs": []
    },
    "lint:npm": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "lint:react-compiler": {
      "dependsOn": [],
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
