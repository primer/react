      "id": "react-tailwind-display-buttongroup-features--loading-buttons"
    },
    {
      "id": "react-tailwind-display-buttongroup-features--icon-buttons-with-tooltip"
    },
    {
      "id": "react-tailwind-display-buttongroup-features--button-and-link"
    },
    {
      "id": "react-tailwind-display-buttongroup-features--links-with-tooltip"
    },
    {
      "id": "react-tailwind-display-buttongroup-features--inactive-buttons-group"
    },
    {
      "id": "react-tailwind-display-buttongroup-features--dropdown-split"
    },
    {
      "id": "react-tailwind-display-buttongroup-features--as-toolbar"
    },
