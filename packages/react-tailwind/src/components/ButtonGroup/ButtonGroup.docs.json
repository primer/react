{
  "id": "buttongroup",
  "name": "ButtonGroup",
  "status": "alpha",
  "importPath": "@primer/react-tailwind/ButtonGroup",
  "description": "`ButtonGroup` joins related buttons into a single segmented control. Use `SegmentedControl` instead when the buttons select between mutually exclusive views.",
  "stories": [
    {
      "id": "react-tailwind-display-buttongroup-examples--formatting-toolbar"
    },
