  "props": [
    {
      "name": "border",
      "type": "boolean",
      "defaultValue": "false",
      "description": "Draws a border around the blankslate."
    },
    {
      "name": "narrow",
      "type": "boolean",
      "defaultValue": "false",
      "description": "Constrains the content to a narrower column."
    },
    {
      "name": "size",
      "type": "\"large\" | \"medium\" | \"small\"",
      "defaultValue": "'medium'",
      "description": "Overall scale of the visual, heading, and spacing."
    },
    {
      "name": "spacious",
      "type": "boolean",
      "defaultValue": "false",
      "description": "Increases the vertical padding, for a blankslate that fills a large empty region."
    }
  ],
  "subcomponents": [
    {
      "name": "Blankslate.Description",
      "props": [],
      "passthrough": {
        "element": "p",
        "url": "https://developer.mozilla.org/en-US/docs/Web/HTML/Element/p#attributes"
      }
    },
    {
      "name": "Blankslate.Heading",
      "props": [
        {
          "name": "as",
          "type": "\"h1\" | \"h2\" | \"h3\" | \"h4\" | \"h5\" | \"h6\"",
          "defaultValue": "'h2'",
          "description": "Heading element to render, so the heading fits the surrounding document outline."
        }
      ],
      "passthrough": {
        "element": "h2",
        "url": "https://developer.mozilla.org/en-US/docs/Web/HTML/Element/h2#attributes"
      }
    },
    {
      "name": "Blankslate.PrimaryAction",
      "props": [
        {
          "name": "href",
          "type": "string"
        }
      ]
    },
    {
      "name": "Blankslate.SecondaryAction",
      "props": [
        {
          "name": "className",
          "type": "string"
        },
        {
          "name": "href",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "Blankslate.Visual",
      "props": [],
      "passthrough": {
        "element": "span",
        "url": "https://developer.mozilla.org/en-US/docs/Web/HTML/Element/span#attributes"
      }
    }
  ],
  "passthrough": {
    "element": "div",
    "url": "https://developer.mozilla.org/en-US/docs/Web/HTML/Element/div#attributes"
