    }
  ],
  "props": [
    {
      "name": "border",
      "type": "boolean",
      "defaultValue": "false"
    },
    {
      "name": "narrow",
      "type": "boolean",
      "defaultValue": "false"
    },
    {
      "name": "size",
      "type": "\"large\" | \"medium\" | \"small\"",
      "defaultValue": "'medium'"
    },
    {
      "name": "spacious",
      "type": "boolean",
      "defaultValue": "false"
    }
  ],
  "subcomponents": [
    {
      "name": "Heading",
      "props": [
        {
          "name": "as",
          "type": "\"h1\" | \"h2\" | \"h3\" | \"h4\" | \"h5\" | \"h6\"",
          "defaultValue": "'h2'"
        }
      ]
    },
    {
      "name": "PrimaryAction",
      "props": [
        {
          "name": "href",
          "type": "string"
        }
      ]
    },
    {
      "name": "SecondaryAction",
      "props": [
        {
          "name": "className",
          "type": "string"
        },
        {
          "name": "href",
          "type": "string",
          "required": true
        }
      ]
    }
  ],
  "passthrough": {
    "element": "div",
    "url": "https://developer.mozilla.org/en-US/docs/Web/HTML/Element/div#attributes"
  }
}
