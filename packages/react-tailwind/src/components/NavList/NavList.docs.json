  "props": [
    {
      "name": "heading",
      "type": "React.ReactNode",
      "description": "Supplies the heading region. Takes precedence over a matching `NavList.Heading` child."
    }
  ],
  "subcomponents": [
    {
      "name": "NavListHeading",
      "props": [
        {
          "name": "visuallyHidden",
          "type": "boolean"
        }
      ]
    },
    {
      "name": "NavListGroup",
      "props": [
        {
          "name": "hideDivider",
          "type": "boolean",
          "defaultValue": "false"
        },
        {
          "name": "title",
          "type": "React.ReactNode"
        }
      ]
    },
    {
      "name": "NavListItem",
      "props": [
        {
          "name": "description",
          "type": "React.ReactNode",
          "description": "Supplies the description region. Takes precedence over a matching `NavList.Description` child."
        },
        {
          "name": "inactiveText",
          "type": "React.ReactNode"
        },
        {
          "name": "leadingVisual",
          "type": "React.ReactNode",
          "description": "Supplies the leadingVisual region. Takes precedence over a matching `NavList.LeadingVisual` child."
        },
        {
          "name": "trailingAction",
          "type": "React.ReactNode",
          "description": "Supplies the trailingAction region. Takes precedence over a matching `NavList.TrailingAction` child."
        },
        {
          "name": "trailingVisual",
          "type": "React.ReactNode",
          "description": "Supplies the trailingVisual region. Takes precedence over a matching `NavList.TrailingVisual` child."
        }
      ]
