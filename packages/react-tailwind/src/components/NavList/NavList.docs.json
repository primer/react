{
  "id": "navlist",
  "name": "NavList",
  "status": "alpha",
  "importPath": "@primer/react-tailwind/NavList",
  "description": "`NavList` is a vertical navigation primitive for settings and page navigation.",
  "stories": [
    {
      "id": "react-tailwind-navigation-navlist-examples--settings-navigation"
    },
    {
      "id": "react-tailwind-navigation-navlist-features--with-sub-items"
    },
    {
      "id": "react-tailwind-navigation-navlist-features--with-nested-sub-items"
    },
    {
      "id": "react-tailwind-navigation-navlist-features--with-inactive-items"
    },
    {
      "id": "react-tailwind-navigation-navlist-features--with-group"
    },
    {
      "id": "react-tailwind-navigation-navlist-features--with-group-heading-links"
    },
    {
      "id": "react-tailwind-navigation-navlist-features--with-trailing-action"
    },
    {
      "id": "react-tailwind-navigation-navlist-features--with-trailing-action-in-sub-item"
    },
    {
      "id": "react-tailwind-navigation-navlist-features--with-expand"
    },
    {
      "id": "react-tailwind-navigation-navlist-features--with-expand-and-icons"
    },
    {
      "id": "react-tailwind-navigation-navlist-features--with-description"
    },
    {
      "id": "react-tailwind-navigation-navlist-features--with-item-gap"
    },
    {
      "id": "react-tailwind-navigation-navlist-features--without-divider"
    },
    {
      "id": "react-tailwind-navigation-navlist-features--with-heading"
    },
    {
      "id": "react-tailwind-navigation-navlist-features--with-visually-hidden-heading"
    },
    {
      "id": "react-tailwind-navigation-navlist-features--current-item"
    },
    {
      "id": "react-tailwind-navigation-navlist--default"
    },
    {
      "id": "react-tailwind-navigation-navlist--playground"
    }
  ],
  "props": [
    {
      "name": "heading",
      "type": "React.ReactNode",
      "description": "Supplies the heading region. Takes precedence over a matching `NavList.Heading` child."
    }
  ],
  "subcomponents": [
    {
      "name": "Heading",
      "props": [
        {
          "name": "as",
          "type": "\"h1\" | \"h2\" | \"h3\" | \"h4\" | \"h5\" | \"h6\""
        },
        {
          "name": "size",
          "type": "\"display\" | \"large\" | \"medium\" | \"small\" | null",
          "defaultValue": "'small'"
        },
        {
          "name": "visuallyHidden",
          "type": "boolean"
        }
      ]
    },
    {
      "name": "Group",
      "props": [
        {
          "name": "hideDivider",
          "type": "boolean",
          "defaultValue": "false"
        },
        {
          "name": "title",
          "type": "React.ReactNode"
        }
      ]
    },
    {
      "name": "Item",
      "props": [
        {
          "name": "description",
          "type": "React.ReactNode"
        },
        {
          "name": "inactiveText",
          "type": "React.ReactNode"
        },
        {
          "name": "leadingVisual",
          "type": "React.ReactNode"
        },
        {
          "name": "trailingAction",
          "type": "React.ReactNode"
        },
        {
          "name": "trailingVisual",
          "type": "React.ReactNode"
        }
      ]
    },
    {
      "name": "TrailingAction",
      "props": [
        {
          "name": "alignContent",
          "type": "\"center\" | \"start\""
        },
        {
          "name": "as",
          "type": "\"a\" | \"button\""
        },
        {
          "name": "block",
          "type": "boolean"
        },
        {
          "name": "className",
          "type": "string"
        },
        {
          "name": "count",
          "type": "string | number"
        },
        {
          "name": "disabled",
          "type": "boolean"
        },
        {
          "name": "href",
          "type": "string"
        },
        {
          "name": "icon",
          "type": "React.ElementType"
        },
        {
          "name": "inactive",
          "type": "boolean"
        },
        {
          "name": "label",
          "type": "string",
          "required": true
        },
        {
          "name": "labelWrap",
          "type": "boolean"
        },
        {
          "name": "loading",
          "type": "boolean"
        },
        {
          "name": "loadingAnnouncement",
          "type": "string"
        },
        {
          "name": "size",
          "type": "ControlSize",
          "defaultValue": "'small'"
        },
        {
          "name": "style",
          "type": "React.CSSProperties"
        }
      ]
    },
    {
      "name": "Description",
      "props": [
        {
          "name": "truncate",
          "type": "boolean"
        },
        {
          "name": "variant",
          "type": "\"block\" | \"inline\""
        }
      ]
    }
  ],
  "passthrough": {
    "element": "nav",
    "url": "https://developer.mozilla.org/en-US/docs/Web/HTML/Element/nav#attributes"
  }
}
