      "id": "react-tailwind-content-banner--playground"
    }
  ],
  "props": [
    {
      "name": "actionsLayout",
      "type": "'inline' | 'stacked' | 'default'",
      "defaultValue": "'default'"
    },
    {
      "name": "description",
      "type": "React.ReactNode"
    },
    {
      "name": "flush",
      "type": "boolean",
      "defaultValue": "false"
    },
    {
      "name": "hideTitle",
      "type": "boolean",
      "defaultValue": "false"
    },
    {
      "name": "layout",
      "type": "'default' | 'compact'",
      "defaultValue": "'default'"
    },
    {
      "name": "leadingVisual",
      "type": "React.ReactNode"
    },
    {
      "name": "onDismiss",
      "type": "() => void"
    },
    {
      "name": "primaryAction",
      "type": "React.ReactNode"
    },
    {
      "name": "secondaryAction",
      "type": "React.ReactNode"
    },
    {
      "name": "title",
      "type": "React.ReactNode"
    },
    {
      "name": "variant",
      "type": "BannerVariant",
      "defaultValue": "'info'"
    }
  ],
  "subcomponents": [
    {
      "name": "BannerTitle",
      "props": [
        {
          "name": "as",
          "type": "'h2' | 'h3' | 'h4' | 'h5' | 'h6'",
          "defaultValue": "'h2'"
        }
      ]
    },
    {
      "name": "BannerActions",
      "props": [
        {
          "name": "primaryAction",
          "type": "React.ReactNode"
        },
        {
          "name": "secondaryAction",
          "type": "React.ReactNode"
        }
      ]
    }
  ]
}
