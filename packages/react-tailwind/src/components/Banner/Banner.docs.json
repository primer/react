    },
    {
      "id": "react-tailwind-content-banner-features--critical"
    },
    {
      "id": "react-tailwind-content-banner-features--info"
    },
    {
      "id": "react-tailwind-content-banner-features--success"
    },
    {
      "id": "react-tailwind-content-banner-features--upsell"
    },
    {
      "id": "react-tailwind-content-banner-features--warning"
    },
    {
      "id": "react-tailwind-content-banner-features--dismiss"
    },
    {
      "id": "react-tailwind-content-banner-features--dismiss-with-actions"
    },
    {
      "id": "react-tailwind-content-banner-features--with-hidden-title"
    },
    {
      "id": "react-tailwind-content-banner-features--with-hidden-title-and-actions"
    },
    {
      "id": "react-tailwind-content-banner-features--dismissible-with-hidden-title-and-actions"
