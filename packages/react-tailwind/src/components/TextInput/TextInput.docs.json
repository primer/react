      "id": "react-tailwind-forms-textinput--playground"
    }
  ],
  "props": [
    {
      "name": "block",
      "type": "boolean",
      "defaultValue": "false"
    },
    {
      "name": "characterLimit",
      "type": "number"
    },
    {
      "name": "contrast",
      "type": "boolean",
      "defaultValue": "false"
    },
    {
      "name": "leadingVisual",
      "type": "TextInputVisual"
    },
    {
      "name": "loaderPosition",
      "type": "'auto' | 'leading' | 'trailing'",
      "defaultValue": "'auto'"
    },
    {
      "name": "loaderText",
      "type": "string",
      "defaultValue": "'Loading'"
    },
    {
      "name": "loading",
      "type": "boolean",
      "defaultValue": "false"
    },
    {
      "name": "monospace",
      "type": "boolean",
      "defaultValue": "false"
    },
    {
      "name": "size",
      "type": "ControlSize",
      "defaultValue": "'medium'"
    },
    {
      "name": "trailingAction",
      "type": "React.ReactElement"
    },
    {
      "name": "trailingVisual",
      "type": "TextInputVisual"
    },
    {
      "name": "validationStatus",
      "type": "'error' | 'success'"
    }
  ],
  "subcomponents": [
    {
      "name": "TextInputAction",
      "props": [
        {
          "name": "aria-label",
          "type": "string"
        },
        {
          "name": "icon",
          "type": "React.ElementType"
        },
        {
          "name": "tooltipDirection",
          "type": "TextInputActionDirection",
          "defaultValue": "'s'"
        }
      ]
    }
  ]
}
