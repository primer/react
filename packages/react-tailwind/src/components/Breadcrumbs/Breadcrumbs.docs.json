  "props": [
    {
      "name": "overflow",
      "type": "\"menu\" | \"menu-with-root\" | \"wrap\"",
      "defaultValue": "'wrap'",
      "description": "How the trail behaves when it is too wide: wrap onto another line, or collapse the middle into a menu."
    },
    {
      "name": "variant",
      "type": "\"normal\" | \"spacious\"",
      "defaultValue": "'normal'",
      "description": "Use `spacious` to increase the spacing between items."
    }
  ],
  "subcomponents": [
    {
      "name": "Breadcrumbs.Item",
      "props": [
        {
          "name": "as",
          "type": "As",
          "defaultValue": "'a'",
          "description": "Element or component supplied by the wrapper."
        },
        {
          "name": "className",
          "type": "string"
        },
        {
          "name": "ref",
          "type": "Ref<HTMLElement>"
        },
        {
          "name": "selected",
          "type": "boolean",
          "description": "Marks the item as the current page, which is announced to assistive technology."
        }
      ],
      "passthrough": {
        "element": "a",
        "url": "https://developer.mozilla.org/en-US/docs/Web/HTML/Element/a#attributes"
