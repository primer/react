{
  "id": "stack",
  "name": "Stack",
  "status": "alpha",
  "importPath": "@primer/react-tailwind/Stack",
  "description": "`Stack` arranges related content along one axis with token-based spacing, alignment, wrapping, and responsive direction.",
  "stories": [
    {
      "id": "react-tailwind-layout-stack-examples--settings-summary"
    },
    {
      "id": "react-tailwind-layout-stack-features--gap-scale"
    },
    {
      "id": "react-tailwind-layout-stack-features--directional-padding"
    },
    {
      "id": "react-tailwind-layout-stack-features--padding-scale"
    },
    {
      "id": "react-tailwind-layout-stack-features--shrinking-stack-items"
    },
    {
      "id": "react-tailwind-layout-stack-features--responsive-direction"
    },
    {
      "id": "react-tailwind-layout-stack--default"
    },
    {
      "id": "react-tailwind-layout-stack--playground"
    },
    {
      "id": "react-tailwind-layout-stack--responsive"
    }
  ],
  "props": [
    {
      "name": "align",
      "type": "ResponsiveValue<\"baseline\" | \"center\" | \"end\" | \"start\" | \"stretch\">",
      "defaultValue": "'stretch'"
    },
    {
      "name": "as",
      "type": "React.ElementType",
      "defaultValue": "'div'"
    },
    {
      "name": "direction",
      "type": "ResponsiveValue<\"horizontal\" | \"vertical\">",
      "defaultValue": "'vertical'"
    },
    {
      "name": "gap",
      "type": "ResponsiveValue<Gap>",
      "defaultValue": "'normal'"
    },
    {
      "name": "justify",
      "type": "ResponsiveValue<\"center\" | \"end\" | \"space-between\" | \"space-evenly\" | \"start\">",
      "defaultValue": "'start'"
    },
    {
      "name": "padding",
      "type": "ResponsiveValue<Gap>",
      "defaultValue": "'none'"
    },
    {
      "name": "paddingBlock",
      "type": "ResponsiveValue<Gap>"
    },
    {
      "name": "paddingInline",
      "type": "ResponsiveValue<Gap>"
    },
    {
      "name": "wrap",
      "type": "ResponsiveValue<\"nowrap\" | \"wrap\">",
      "defaultValue": "'nowrap'"
    }
  ]
}
