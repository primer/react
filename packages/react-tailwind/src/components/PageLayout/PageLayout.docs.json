  "props": [
    {
      "name": "columnGap",
      "type": "Spacing",
      "defaultValue": "'normal'",
      "description": "Horizontal spacing between the sidebar, content, and pane."
    },
    {
      "name": "containerWidth",
      "type": "\"full\" | \"large\" | \"medium\" | \"xlarge\"",
      "defaultValue": "'xlarge'",
      "description": "Maximum width of the centered content column."
    },
    {
      "name": "footer",
      "type": "React.ReactNode",
      "description": "Supplies the footer region. Takes precedence over a matching `PageLayout.Footer` child."
    },
    {
      "name": "header",
      "type": "React.ReactNode",
      "description": "Supplies the header region. Takes precedence over a matching `PageLayout.Header` child."
    },
    {
      "name": "padding",
      "type": "Spacing",
      "defaultValue": "'normal'",
      "description": "Spacing between the page container's outer edges and the viewport."
    },
    {
      "name": "rowGap",
      "type": "Spacing",
      "defaultValue": "'normal'",
      "description": "Vertical spacing between the header, content, and footer."
    },
    {
      "name": "sidebar",
      "type": "React.ReactNode",
      "description": "Supplies the sidebar region. Takes precedence over a matching `PageLayout.Sidebar` child."
    }
  ],
  "subcomponents": [
    {
      "name": "Header",
      "props": [
        {
          "name": "divider",
          "type": "ResponsiveValue<\"filled\" | \"line\" | \"none\">",
          "defaultValue": "'none'"
        },
        {
          "name": "hidden",
          "type": "ResponsiveValue<boolean>"
        },
        {
          "name": "padding",
          "type": "Spacing",
          "defaultValue": "'normal'"
        }
      ]
    },
    {
      "name": "Content",
      "props": [
        {
          "name": "as",
          "type": "React.ElementType",
          "defaultValue": "'main'"
        },
        {
          "name": "hidden",
          "type": "ResponsiveValue<boolean>"
        },
        {
          "name": "padding",
          "type": "Spacing",
          "defaultValue": "'normal'"
        },
        {
          "name": "width",
          "type": "\"full\" | \"large\" | \"medium\" | \"xlarge\"",
          "defaultValue": "'full'"
        }
      ]
    },
    {
      "name": "Pane",
      "props": [
        {
          "name": "currentWidth",
          "type": "number"
        },
        {
          "name": "divider",
          "type": "ResponsiveValue<PaneDivider>",
          "defaultValue": "'none'"
        },
        {
          "name": "hidden",
          "type": "ResponsiveValue<boolean>"
        },
        {
          "name": "minWidth",
          "type": "number",
          "defaultValue": "256"
        },
        {
          "name": "offsetHeader",
          "type": "string | number",
          "defaultValue": "0"
        },
        {
          "name": "onResizeEnd",
          "type": "((width: number) => void)"
        },
        {
          "name": "padding",
          "type": "Spacing",
          "defaultValue": "'normal'"
        },
        {
          "name": "position",
          "type": "ResponsiveValue<PanePosition>",
          "defaultValue": "'end'"
        },
        {
          "name": "resizable",
          "type": "boolean",
          "defaultValue": "false"
        },
        {
          "name": "sticky",
          "type": "boolean",
          "defaultValue": "false"
        },
        {
          "name": "width",
          "type": "PaneWidthValue",
          "defaultValue": "'full'"
        },
        {
          "name": "widthStorageKey",
          "type": "string",
          "defaultValue": "'paneWidth'"
        }
      ]
    },
    {
      "name": "Sidebar",
      "props": [
        {
          "name": "currentWidth",
          "type": "number"
        },
        {
          "name": "divider",
          "type": "ResponsiveValue<PaneDivider>",
          "defaultValue": "'none'"
        },
        {
          "name": "hidden",
          "type": "ResponsiveValue<boolean>"
        },
        {
          "name": "minWidth",
          "type": "number",
          "defaultValue": "256"
        },
        {
          "name": "offsetHeader",
          "type": "string | number",
          "defaultValue": "0"
        },
        {
          "name": "onResizeEnd",
          "type": "((width: number) => void)"
        },
        {
          "name": "padding",
          "type": "Spacing",
          "defaultValue": "'normal'"
        },
        {
          "name": "position",
          "type": "ResponsiveValue<PanePosition>",
          "defaultValue": "'end'"
        },
        {
          "name": "resizable",
          "type": "boolean",
          "defaultValue": "false"
        },
        {
          "name": "responsiveVariant",
          "type": "\"default\" | \"fullscreen\"",
          "defaultValue": "'default'"
        },
        {
          "name": "sticky",
          "type": "boolean",
          "defaultValue": "false"
        },
        {
          "name": "width",
          "type": "PaneWidthValue",
          "defaultValue": "'full'"
        },
        {
          "name": "widthStorageKey",
          "type": "string",
          "defaultValue": "'paneWidth'"
        }
      ]
    },
    {
      "name": "Footer",
      "props": [
        {
          "name": "divider",
          "type": "\"filled\" | \"line\" | \"none\"",
          "defaultValue": "'none'"
        },
        {
          "name": "hidden",
          "type": "ResponsiveValue<boolean>"
        },
        {
          "name": "padding",
          "type": "Spacing",
          "defaultValue": "'normal'"
        }
      ]
    }
  ],
  "passthrough": {
    "element": "div",
    "url": "https://developer.mozilla.org/en-US/docs/Web/HTML/Element/div#attributes"
  }
