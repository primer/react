{
  "id": "truncate",
  "name": "Truncate",
  "status": "alpha",
  "importPath": "@primer/react-tailwind/Truncate",
  "description": "`Truncate` applies single-line overflow truncation while preserving the full value in the native `title` tooltip.",
  "stories": [
    {
      "id": "react-tailwind-display-truncate-examples--navigation-label"
    },
    {
      "id": "react-tailwind-display-truncate-examples--custom-content"
    },
    {
      "id": "react-tailwind-display-truncate-examples--narrow-container"
    },
    {
      "id": "react-tailwind-display-truncate-features--expandable"
    },
    {
      "id": "react-tailwind-display-truncate-features--inline"
    },
    {
      "id": "react-tailwind-display-truncate-features--max-width"
    },
    {
      "id": "react-tailwind-display-truncate-features--overflow"
    },
    {
      "id": "react-tailwind-display-truncate-features--custom-element"
    },
    {
      "id": "react-tailwind-display-truncate--default"
    },
    {
      "id": "react-tailwind-display-truncate--playground"
    }
  ],
  "props": [
    {
      "name": "as",
      "type": "React.ElementType",
      "defaultValue": "'span'",
      "description": "Element to render."
    },
    {
      "name": "expandable",
      "type": "boolean",
      "description": "Reveals the full text on hover and focus."
    },
    {
      "name": "inline",
      "type": "boolean",
      "description": "Renders inline rather than as a block."
    },
    {
      "name": "maxWidth",
      "type": "string | number",
      "defaultValue": "125",
      "description": "Width past which the text is clipped."
    },
    {
      "name": "title",
      "type": "string",
      "required": true,
      "description": "Full text, shown on hover and kept available to assistive technology when the text is clipped."
    }
  ]
}
