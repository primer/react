  "subcomponents": [
    {
      "name": "SelectPanelOverlay",
      "props": [
        {
          "name": "alignOffset",
          "type": "PopoverPositionerProps['alignOffset']"
        },
        {
          "name": "className",
          "type": "string"
        },
        {
          "name": "collisionBoundary",
          "type": "PopoverPositionerProps['collisionBoundary']"
        },
        {
          "name": "collisionPadding",
          "type": "PopoverPositionerProps['collisionPadding']"
        },
        {
          "name": "height",
          "type": "PanelHeight"
        },
        {
          "name": "maxHeight",
          "type": "Exclude<PanelHeight, 'auto' | 'initial' | 'fit-content'>"
        },
        {
          "name": "portal",
          "type": "boolean",
          "defaultValue": "true"
        },
        {
          "name": "positionerClassName",
          "type": "string"
        },
        {
          "name": "side",
          "type": "PopoverPositionerProps['side']",
          "defaultValue": "'bottom'"
        },
        {
          "name": "sideOffset",
          "type": "PopoverPositionerProps['sideOffset']",
          "defaultValue": "4"
        },
        {
          "name": "style",
          "type": "React.CSSProperties"
        },
        {
          "name": "width",
          "type": "PanelWidth"
        }
      ]
    },
