    {
      "name": "selectionVariant",
      "type": "SelectionVariant"
    },
    {
      "name": "showDividers",
      "type": "boolean",
      "defaultValue": "false"
    },
    {
      "name": "variant",
      "type": "'inset' | 'horizontal-inset' | 'full'",
      "defaultValue": "'inset'"
    }
  ],
  "subcomponents": [
    {
      "name": "ActionListItem",
      "props": [
        {
          "name": "active",
          "type": "boolean"
        },
        {
          "name": "children",
          "type": "React.ReactNode"
        },
        {
          "name": "className",
          "type": "string"
        },
        {
          "name": "description",
          "type": "React.ReactNode",
          "description": "Supplies the description region. Takes precedence over a matching `ActionList.Description` child."
        },
        {
          "name": "disabled",
          "type": "boolean"
        },
        {
          "name": "inactiveText",
          "type": "React.ReactNode"
        },
        {
          "name": "leadingVisual",
          "type": "React.ReactNode",
          "description": "Supplies the leadingVisual region. Takes precedence over a matching `ActionList.LeadingVisual` child."
        },
        {
          "name": "loading",
          "type": "boolean",
          "defaultValue": "false"
        },
        {
          "name": "loadingText",
          "type": "string"
        },
        {
          "name": "onSelect",
          "type": "(event: React.MouseEvent<HTMLElement> | React.KeyboardEvent<HTMLElement>) => void"
        },
        {
          "name": "selected",
          "type": "boolean"
        },
        {
          "name": "size",
          "type": "'medium' | 'large'",
          "defaultValue": "'medium'"
        },
        {
          "name": "trailingAction",
          "type": "React.ReactNode",
          "description": "Supplies the trailingAction region. Takes precedence over a matching `ActionList.TrailingAction` child."
        },
        {
          "name": "trailingVisual",
          "type": "React.ReactNode",
          "description": "Supplies the trailingVisual region. Takes precedence over a matching `ActionList.TrailingVisual` child."
        },
        {
          "name": "variant",
          "type": "'default' | 'danger'",
          "defaultValue": "'inset'"
        }
      ]
    },
    {
      "name": "ActionListLinkItem",
      "props": [
        {
          "name": "description",
          "type": "React.ReactNode",
          "description": "Supplies the description region. Takes precedence over a matching `ActionList.Description` child."
        },
        {
          "name": "leadingVisual",
          "type": "React.ReactNode",
          "description": "Supplies the leadingVisual region. Takes precedence over a matching `ActionList.LeadingVisual` child."
        },
        {
          "name": "selected",
          "type": "boolean"
        },
        {
          "name": "trailingAction",
          "type": "React.ReactNode",
          "description": "Supplies the trailingAction region. Takes precedence over a matching `ActionList.TrailingAction` child."
        },
        {
          "name": "trailingVisual",
          "type": "React.ReactNode",
          "description": "Supplies the trailingVisual region. Takes precedence over a matching `ActionList.TrailingVisual` child."
        },
        {
          "name": "variant",
          "type": "'default' | 'danger'",
          "defaultValue": "'inset'"
        }
      ]
    },
    {
      "name": "ActionListGroup",
      "props": [
        {
          "name": "heading",
          "type": "React.ReactNode",
          "description": "Supplies the heading region. Takes precedence over a matching `ActionList.Heading` child."
        },
        {
          "name": "selectionVariant",
          "type": "SelectionVariant"
        },
        {
          "name": "title",
          "type": "React.ReactNode"
        }
      ]
    },
    {
      "name": "ActionListGroupHeading",
      "props": [
        {
          "name": "as",
