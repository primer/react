    {
      "name": "format",
      "type": "\"condensed\" | \"full\"",
      "defaultValue": "'condensed'"
    },
    {
      "name": "keys",
      "type": "string",
      "required": true
    },
    {
      "name": "size",
      "type": "\"medium\" | \"small\"",
      "defaultValue": "'medium'"
    },
    {
      "name": "variant",
      "type": "\"default\" | \"onEmphasis\" | \"onPrimary\"",
      "defaultValue": "'default'"
    }
