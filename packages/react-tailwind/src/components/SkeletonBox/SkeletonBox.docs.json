{
  "id": "skeletonbox",
  "name": "SkeletonBox",
  "status": "alpha",
  "importPath": "@primer/react-tailwind/SkeletonBox",
  "description": "`SkeletonBox` reserves space for content that is loading, using a shimmer placeholder that can be delayed until a request has taken long enough to show.",
  "stories": [
    {
      "id": "react-tailwind-display-skeletonbox-examples--comments-loading"
    },
    {
      "id": "react-tailwind-display-skeletonbox-examples--comments-loading-with-suspense"
    },
    {
      "id": "react-tailwind-display-skeletonbox-features--custom-height"
    },
    {
      "id": "react-tailwind-display-skeletonbox-features--custom-width"
    },
    {
      "id": "react-tailwind-display-skeletonbox-features--with-delay"
    },
    {
      "id": "react-tailwind-display-skeletonbox-features--custom-element"
    },
    {
      "id": "react-tailwind-display-skeletonbox-features--reduced-motion"
    },
    {
      "id": "react-tailwind-display-skeletonbox--default"
    },
    {
      "id": "react-tailwind-display-skeletonbox--playground"
    }
  ],
  "props": [
    {
      "name": "as",
      "type": "React.ElementType",
      "defaultValue": "'div'",
      "description": "Element to render."
    },
    {
      "name": "data-component",
      "type": "string",
      "description": "Overrides the marker used to identify this element in tests and styling."
    },
    {
      "name": "delay",
      "type": "number | \"long\" | \"short\"",
      "description": "Waits before showing the placeholder, so a fast response never flashes one. Accepts a named delay or milliseconds."
    },
    {
      "name": "height",
      "type": "Height<string | number>",
      "description": "Height of the placeholder."
    },
    {
      "name": "width",
      "type": "Width<string | number>",
      "description": "Width of the placeholder."
    }
  ],
  "passthrough": {
    "element": "div",
    "url": "https://developer.mozilla.org/en-US/docs/Web/HTML/Element/div#attributes"
  }
}
