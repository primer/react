    }
  ],
  "props": [
    {
      "name": "caption",
      "type": "React.ReactNode",
      "description": "Supplies the caption region. Takes precedence over a matching `FormControl.Caption` child."
    },
    {
      "name": "className",
      "type": "Field.Root.Props['className']"
    },
    {
      "name": "label",
      "type": "React.ReactNode",
      "description": "Supplies the label region. Takes precedence over a matching `FormControl.Label` child."
    },
    {
      "name": "layout",
      "type": "'horizontal' | 'vertical'",
      "defaultValue": "'vertical'"
    },
    {
      "name": "leadingVisual",
      "type": "React.ReactNode",
      "description": "Supplies the leadingVisual region. Takes precedence over a matching `FormControl.LeadingVisual` child."
    },
    {
      "name": "required",
      "type": "boolean",
      "defaultValue": "false"
    },
    {
      "name": "validation",
      "type": "React.ReactNode",
      "description": "Supplies the validation region. Takes precedence over a matching `FormControl.Validation` child."
    }
  ],
  "subcomponents": [
    {
      "name": "FormControlLabel",
      "props": [
        {
          "name": "className",
          "type": "Field.Label.Props['className']"
        },
        {
          "name": "requiredIndicator",
          "type": "boolean",
          "defaultValue": "true"
        },
        {
          "name": "requiredText",
          "type": "string"
        },
        {
          "name": "visuallyHidden",
          "type": "boolean"
        }
      ]
    },
    {
      "name": "FormControlCaption",
      "props": [
        {
          "name": "className",
          "type": "Field.Description.Props['className']"
        }
      ]
    },
    {
      "name": "FormControlValidation",
      "props": [
        {
          "name": "className",
          "type": "string"
        },
        {
          "name": "variant",
          "type": "'error' | 'success'"
        }
      ]
    }
  ]
}
