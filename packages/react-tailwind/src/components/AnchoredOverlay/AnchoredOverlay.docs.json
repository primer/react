  "subcomponents": [
    {
      "name": "Content",
      "props": [
        {
          "name": "align",
          "type": "FloatingAlignment",
          "defaultValue": "'start'",
          "description": "Alignment of the content along the anchor's edge."
        },
        {
          "name": "alignOffset",
          "type": "FloatingOffset",
          "description": "Shift in pixels along the anchor's edge, or a callback that computes it from the measured sizes."
        },
        {
          "name": "portal",
          "type": "boolean",
          "defaultValue": "true",
          "description": "Where the content is rendered in the DOM. Set `false` to keep it in place."
        },
        {
          "name": "positionerClassName",
          "type": "string",
          "description": "Classes applied to the element that positions the content."
        },
        {
          "name": "side",
          "type": "FloatingSide",
          "defaultValue": "'bottom'",
          "description": "Side of the anchor the content opens on."
        },
        {
          "name": "sideOffset",
          "type": "FloatingOffset",
          "defaultValue": "4",
          "description": "Distance in pixels between the content and its anchor, or a callback that computes it."
        }
      ]
    }
  ]
