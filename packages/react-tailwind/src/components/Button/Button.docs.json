  "props": [
    {
      "name": "alignContent",
      "type": "\"center\" | \"start\"",
      "defaultValue": "'center'",
      "description": "Whether the label sits centred or hugs the start edge when visuals are present."
    },
    {
      "name": "block",
      "type": "boolean",
      "description": "Stretches the button to fill the width of its container."
    },
    {
      "name": "children",
      "type": "React.ReactNode"
    },
    {
      "name": "className",
      "type": "string"
    },
    {
      "name": "count",
      "type": "string | number",
      "description": "Number shown in a trailing counter, for a button that acts on a known quantity."
    },
    {
      "name": "data-component",
      "type": "string",
      "defaultValue": "'Button'",
      "description": "Overrides the marker used to identify this element in tests and styling."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "description": "Prevents activation and removes the button from the keyboard order."
    },
    {
      "name": "inactive",
      "type": "boolean",
      "description": "Marks the button temporarily unavailable while keeping it focusable, so its reason can be announced."
    },
    {
      "name": "labelWrap",
      "type": "boolean",
      "description": "Lets a long label wrap onto more than one line instead of being clipped."
    },
    {
      "name": "leadingVisual",
      "type": "ButtonVisual",
      "description": "Icon shown before the label."
    },
    {
      "name": "loading",
      "type": "boolean",
      "description": "Replaces the leading visual with a spinner and suppresses activation."
    },
    {
      "name": "loadingAnnouncement",
      "type": "string",
      "defaultValue": "'Loading'",
      "description": "Text announced to assistive technology while the button is loading."
    },
    {
      "name": "notificationIndicator",
      "type": "\"button\" | \"leadingVisual\"",
      "description": "Shows a dot for new activity on the button boundary or on the leading visual. `leadingVisual` requires a\n`leadingVisual`. The dot is not announced, so describe the activity in the accessible name or description."
    },
    {
      "name": "size",
      "type": "ControlSize",
      "defaultValue": "'medium'",
      "description": "Height and text size of the button."
    },
    {
      "name": "trailingAction",
      "type": "ButtonVisual",
      "description": "Icon shown at the far end, conventionally a chevron for a button that opens something."
    },
    {
      "name": "trailingVisual",
      "type": "ButtonVisual",
      "description": "Icon shown after the label."
    },
    {
      "name": "variant",
      "type": "\"danger\" | \"default\" | \"invisible\" | \"link\" | \"primary\"",
      "defaultValue": "'default'",
      "description": "Visual weight of the button. Use `primary` for the main action and `danger` for a destructive one."
    }
  ],
  "subcomponents": [
    {
      "name": "ButtonBase",
      "props": [
        {
          "name": "data-component",
          "type": "string",
          "defaultValue": "'ButtonBase'",
          "description": "Overrides the marker used to identify this element in tests and styling."
        }
      ],
