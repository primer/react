      "id": "react-tailwind-navigation-underlinenav--playground"
    }
  ],
  "props": [
    {
      "name": "as",
      "type": "React.ElementType",
      "defaultValue": "'nav'",
      "description": "Element to render."
    },
    {
      "name": "hideIconsBreakpoint",
      "type": "HideIconsBreakpoint",
      "defaultValue": "'medium'",
      "description": "Container width below which item icons are hidden to save space. To keep icons visible in a narrow container,\nuse a smaller breakpoint such as `xsmall`, or set to `null` to always show icons."
    },
    {
      "name": "loadingCounters",
      "type": "boolean",
      "defaultValue": "false",
      "description": "Shows placeholders in place of item counters while their values load."
    },
    {
      "name": "variant",
      "type": "\"flush\" | \"inset\"",
      "defaultValue": "'inset'",
      "description": "Whether the bar is inset from its container or sits flush against it."
    }
  ],
  "subcomponents": [
    {
      "name": "UnderlineNav.Item",
      "props": [
        {
          "name": "as",
          "type": "React.ElementType",
          "defaultValue": "'a'",
          "description": "Element to render, such as a router link component. Native anchors default to `href=\"#\"`; custom components\nreceive no default `href`, so they can supply their own navigation target."
        },
        {
          "name": "counter",
          "type": "string | number",
          "description": "Number shown after the label."
        },
        {
          "name": "leadingVisual",
          "type": "React.ReactNode",
          "description": "Icon shown before the label."
        },
        {
          "name": "onSelect",
          "type": "((event: MouseEvent<HTMLElement, MouseEvent>) => void)",
          "description": "Called when the item is activated, from the bar or from the \"More\" menu."
        }
      ],
      "passthrough": {
        "element": "a",
        "url": "https://developer.mozilla.org/en-US/docs/Web/HTML/Element/a#attributes"
      }
    }
  ],
  "passthrough": {
    "element": "nav",
    "url": "https://developer.mozilla.org/en-US/docs/Web/HTML/Element/nav#attributes"
  }
}
