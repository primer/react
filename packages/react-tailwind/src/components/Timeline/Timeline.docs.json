  "props": [
    {
      "name": "clipSidebar",
      "type": "\"both\" | \"end\" | \"start\" | boolean",
      "description": "Trims the connecting line at the start, the end, or both, where the timeline meets other content."
    }
  ],
  "subcomponents": [
    {
      "name": "Item",
      "props": [
        {
          "name": "condensed",
          "type": "boolean",
          "description": "Reduces the item's vertical spacing, for a minor event in the timeline."
        }
      ]
    },
    {
      "name": "Badge",
      "props": [
        {
          "name": "variant",
          "type": "\"accent\" | \"attention\" | \"closed\" | \"danger\" | \"done\" | \"open\" | \"severe\" | \"sponsors\" | \"success\"",
          "description": "Colour of the badge, conveying what kind of event it marks."
        }
      ]
    }
  ],
