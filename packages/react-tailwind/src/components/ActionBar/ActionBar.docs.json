{
  "id": "actionbar",
  "name": "ActionBar",
  "status": "alpha",
  "importPath": "@primer/react-tailwind/ActionBar",
  "description": "`ActionBar` groups related actions with `Button`, `IconButton`, `Group`, `Divider`, and `Menu` parts.",
  "stories": [
    {
      "id": "react-tailwind-data-actionbar-examples--with-groups"
    },
    {
      "id": "react-tailwind-data-actionbar-examples--small-action-bar"
    },
    {
      "id": "react-tailwind-data-actionbar-examples--with-text-buttons"
    },
    {
      "id": "react-tailwind-data-actionbar-examples--gap-scale"
    },
    {
      "id": "react-tailwind-data-actionbar-examples--with-disabled-items"
    },
    {
      "id": "react-tailwind-data-actionbar-examples--comment-box"
    },
    {
      "id": "react-tailwind-data-actionbar-examples--action-bar-with-menu-trigger"
    },
    {
      "id": "react-tailwind-data-actionbar-examples--actionbar-toggle"
    },
    {
      "id": "react-tailwind-data-actionbar-examples--multiple-action-bars"
    },
    {
      "id": "react-tailwind-data-actionbar-examples--with-menus"
    },
    {
      "id": "react-tailwind-data-actionbar-features--roving-focus"
    },
    {
      "id": "react-tailwind-data-actionbar--default"
    },
    {
      "id": "react-tailwind-data-actionbar--playground"
    }
  ],
  "props": [
    {
      "name": "flush",
      "type": "boolean",
      "defaultValue": "false"
    },
    {
      "name": "gap",
      "type": "\"condensed\" | \"none\"",
      "defaultValue": "'condensed'"
    },
    {
      "name": "size",
      "type": "ControlSize",
      "defaultValue": "'medium'"
    }
  ],
  "subcomponents": [
    {
      "name": "Button",
      "props": [
        {
          "name": "alignContent",
          "type": "\"center\" | \"start\""
        },
        {
          "name": "block",
          "type": "boolean"
        },
        {
          "name": "children",
          "type": "React.ReactElement[]"
        },
        {
          "name": "className",
          "type": "string"
        },
        {
          "name": "count",
          "type": "string | number"
        },
        {
          "name": "disabled",
          "type": "boolean"
        },
        {
          "name": "inactive",
          "type": "boolean"
        },
        {
          "name": "labelWrap",
          "type": "boolean"
        },
        {
          "name": "leadingVisual",
          "type": "ButtonVisual"
        },
        {
          "name": "loading",
          "type": "boolean"
        },
        {
          "name": "loadingAnnouncement",
          "type": "string"
        },
        {
          "name": "size",
          "type": "ControlSize",
          "defaultValue": "'medium'"
        },
        {
          "name": "trailingAction",
          "type": "ButtonVisual"
        },
        {
          "name": "trailingVisual",
          "type": "ButtonVisual"
        }
      ]
    },
    {
      "name": "IconButton",
      "props": [
        {
          "name": "alignContent",
          "type": "\"center\" | \"start\""
        },
        {
          "name": "aria-label",
          "type": "string",
          "required": true,
          "description": "Defines a string value that labels the current element."
        },
        {
          "name": "block",
          "type": "boolean"
        },
        {
          "name": "className",
          "type": "string"
        },
        {
          "name": "count",
          "type": "string | number"
        },
        {
          "name": "disabled",
          "type": "boolean"
        },
        {
          "name": "icon",
          "type": "React.ElementType",
          "defaultValue": "KebabHorizontalIcon",
          "required": true
        },
        {
          "name": "inactive",
          "type": "boolean"
        },
        {
          "name": "labelWrap",
          "type": "boolean"
        },
        {
          "name": "loading",
          "type": "boolean"
        },
        {
          "name": "loadingAnnouncement",
          "type": "string"
        },
        {
          "name": "size",
          "type": "ControlSize",
          "defaultValue": "'medium'"
        },
        {
          "name": "trailingAction",
          "type": "ButtonVisual"
        }
      ]
    },
    {
      "name": "Menu",
      "props": [
        {
          "name": "aria-label",
          "type": "string",
          "required": true
        },
        {
          "name": "icon",
          "type": "React.ElementType",
          "defaultValue": "KebabHorizontalIcon"
        },
        {
          "name": "items",
          "type": "ActionBarMenuItem[]",
          "required": true
        }
      ]
    }
  ]
}
