  "props": [
    {
      "name": "block",
      "type": "boolean",
      "defaultValue": "false",
      "description": "Makes the visible control fill its container."
    },
    {
      "name": "className",
      "type": "string",
      "description": "Classes applied to the visible control wrapper."
    },
    {
      "name": "placeholder",
      "type": "string",
      "description": "Text rendered as an initially selected empty-value option."
    },
    {
      "name": "size",
      "type": "ControlSize",
      "description": "Primer control height and typography."
    },
    {
      "name": "validationStatus",
      "type": "ValidationStatus",
      "description": "Applies error or success control styling."
    }
  ],
  "subcomponents": [
    {
      "name": "Select.Option",
      "props": [],
      "passthrough": {
        "element": "option",
        "url": "https://developer.mozilla.org/en-US/docs/Web/HTML/Element/option#attributes"
      }
    },
    {
      "name": "Select.OptGroup",
      "props": [],
      "passthrough": {
        "element": "optgroup",
        "url": "https://developer.mozilla.org/en-US/docs/Web/HTML/Element/optgroup#attributes"
      }
    }
  ],
  "passthrough": {
    "element": "select",
    "url": "https://developer.mozilla.org/en-US/docs/Web/HTML/Element/select#attributes"
  }
