  "props": [
    {
      "name": "alignContent",
      "type": "\"center\" | \"start\"",
      "defaultValue": "'center'"
    },
    {
      "name": "block",
      "type": "boolean"
    },
    {
      "name": "children",
      "type": "React.ReactElement[]"
    },
    {
      "name": "count",
      "type": "string | number"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "defaultValue": "false"
    },
    {
      "name": "inactive",
      "type": "boolean"
    },
    {
      "name": "labelWrap",
      "type": "boolean"
    },
    {
      "name": "leadingVisual",
      "type": "ButtonVisual"
    },
    {
      "name": "loading",
      "type": "boolean",
      "defaultValue": "false"
    },
    {
      "name": "loadingAnnouncement",
      "type": "string",
      "defaultValue": "'Loading'"
    },
    {
      "name": "onClick",
      "type": "MouseEventHandler<HTMLAnchorElement>"
    },
    {
      "name": "render",
      "type": "RenderProp<LinkButtonState>"
    },
    {
      "name": "size",
      "type": "ControlSize"
    },
    {
      "name": "trailingAction",
      "type": "ButtonVisual"
    },
    {
      "name": "trailingVisual",
      "type": "ButtonVisual"
    },
    {
      "name": "variant",
      "type": "\"danger\" | \"default\" | \"invisible\" | \"link\" | \"primary\"",
      "defaultValue": "'default'"
    }
  ],
  "passthrough": {
    "element": "a",
    "url": "https://developer.mozilla.org/en-US/docs/Web/HTML/Element/a#attributes"
  }
}
