{
  "id": "linkbutton",
  "name": "LinkButton",
  "status": "alpha",
  "importPath": "@primer/react-tailwind/LinkButton",
  "description": "`LinkButton` navigates to a URL while looking like a `Button`. It renders an anchor, so it requires `href` rather than `onClick`.",
  "stories": [
    {
      "id": "react-tailwind-components-linkbutton-examples--settings-navigation"
    },
