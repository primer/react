    },
    {
      "id": "react-tailwind-components-linkbutton-features--loading"
    },
    {
      "id": "react-tailwind-components-linkbutton-features--loading-custom-announcement"
    },
    {
      "id": "react-tailwind-components-linkbutton-features--loading-with-leading-visual"
    },
    {
      "id": "react-tailwind-components-linkbutton-features--loading-with-trailing-visual"
    },
    {
      "id": "react-tailwind-components-linkbutton--default"
    },
    {
      "id": "react-tailwind-components-linkbutton--playground"
    }
  ],
  "props": [
    {
      "name": "alignContent",
      "type": "'start' | 'center'",
      "defaultValue": "'center'"
    },
    {
      "name": "block",
      "type": "boolean"
    },
    {
      "name": "children",
      "type": "React.ReactNode"
    },
    {
      "name": "count",
      "type": "number | string"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "defaultValue": "false"
    },
    {
      "name": "inactive",
      "type": "boolean"
    },
    {
      "name": "labelWrap",
      "type": "boolean"
    },
    {
      "name": "leadingVisual",
      "type": "ButtonVisual"
    },
    {
      "name": "loading",
      "type": "boolean",
      "defaultValue": "false"
    },
    {
      "name": "loadingAnnouncement",
      "type": "string",
      "defaultValue": "'Loading'"
    },
    {
      "name": "onClick",
      "type": "React.MouseEventHandler<HTMLAnchorElement>"
    },
    {
      "name": "render",
      "type": "useRender.RenderProp<LinkButtonState>"
    },
    {
      "name": "size",
      "type": "ControlSize"
    },
    {
      "name": "trailingAction",
      "type": "ButtonVisual"
    },
    {
      "name": "trailingVisual",
      "type": "ButtonVisual"
    },
    {
      "name": "variant",
      "type": "'default' | 'primary' | 'danger' | 'invisible' | 'link'",
      "defaultValue": "'default'"
    }
  ]
}
