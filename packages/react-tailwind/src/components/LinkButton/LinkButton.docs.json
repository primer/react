    },
    {
      "id": "react-tailwind-components-linkbutton-features--link"
    },
    {
      "id": "react-tailwind-components-linkbutton-features--leading-visual"
    },
    {
      "id": "react-tailwind-components-linkbutton-features--trailing-visual"
    },
    {
      "id": "react-tailwind-components-linkbutton-features--trailing-action"
    },
    {
      "id": "react-tailwind-components-linkbutton-features--block"
    },
    {
      "id": "react-tailwind-components-linkbutton-features--small"
    },
    {
      "id": "react-tailwind-components-linkbutton-features--medium"
