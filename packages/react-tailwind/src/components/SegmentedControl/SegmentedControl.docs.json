{
  "id": "segmentedcontrol",
  "name": "SegmentedControl",
  "status": "alpha",
  "importPath": "@primer/react-tailwind/SegmentedControl",
  "description": "`SegmentedControl` is a single-choice Base UI toggle group for related view or mode choices.",
  "stories": [
    {
      "id": "react-tailwind-forms-segmentedcontrol-examples--with-disabled-buttons"
    },
    {
      "id": "react-tailwind-forms-segmentedcontrol-features--with-icons"
    },
    {
      "id": "react-tailwind-forms-segmentedcontrol-features--with-counter-labels"
    },
    {
      "id": "react-tailwind-forms-segmentedcontrol-features--controlled"
    },
    {
      "id": "react-tailwind-forms-segmentedcontrol-features--icon-only"
    },
    {
      "id": "react-tailwind-forms-segmentedcontrol-features--variant-narrow-hide-labels"
    },
    {
      "id": "react-tailwind-forms-segmentedcontrol-features--variant-narrow-action-menu"
    },
    {
      "id": "react-tailwind-forms-segmentedcontrol-features--fullwidth-narrow"
    },
    {
      "id": "react-tailwind-forms-segmentedcontrol-features--fullwidth-regular"
    },
    {
      "id": "react-tailwind-forms-segmentedcontrol-features--fullwidth-all"
    },
    {
      "id": "react-tailwind-forms-segmentedcontrol-features--associated-with-a-label-and-caption"
    },
    {
      "id": "react-tailwind-forms-segmentedcontrol-features--focus-visible"
    },
    {
      "id": "react-tailwind-forms-segmentedcontrol--default"
    },
    {
      "id": "react-tailwind-forms-segmentedcontrol--playground"
    }
  ],
  "props": [
    {
      "name": "className",
      "type": "string | ((state: ToggleGroupState) => string | undefined)"
    },
    {
      "name": "fullWidth",
      "type": "ResponsiveValue<boolean>",
      "description": "Stretches the control to fill its container, sharing the width between segments."
    },
    {
      "name": "size",
      "type": "SegmentedControlSize",
      "defaultValue": "'medium'",
      "description": "Height and text size of the segments."
    },
    {
      "name": "variant",
      "type": "\"default\" | Partial<Record<\"narrow\" | \"regular\" | \"wide\", SegmentedControlVariant>>",
      "defaultValue": "'default'",
      "description": "How the control adapts on narrow viewports, such as collapsing into a menu or hiding labels."
    }
  ],
  "subcomponents": [
    {
      "name": "Button",
      "props": [
        {
          "name": "children",
          "type": "React.ReactElement[]"
        },
        {
          "name": "className",
          "type": "string | ((state: ToggleState) => string | undefined)"
        },
        {
          "name": "count",
          "type": "string | number",
          "description": "Number shown after the segment's label."
        },
        {
          "name": "leadingVisual",
          "type": "React.ReactNode",
          "description": "Icon shown before the segment's label."
        },
        {
          "name": "value",
          "type": "string",
          "required": true,
          "description": "Value this segment selects, matched against the control's value."
        }
      ]
    },
    {
      "name": "IconButton",
      "props": [
        {
          "name": "aria-label",
          "type": "string",
          "required": true,
          "description": "Accessible name for the segment, since the icon alone conveys nothing."
        },
        {
          "name": "className",
          "type": "string | ((state: ToggleState) => string | undefined)"
        },
        {
          "name": "count",
          "type": "string | number",
          "description": "Number shown after the segment's label."
        },
        {
          "name": "icon",
          "type": "React.ElementType",
          "required": true,
          "description": "Icon component to render."
        },
        {
          "name": "value",
          "type": "string",
          "required": true,
          "description": "Value this segment selects, matched against the control's value."
        }
      ]
    }
  ]
}
