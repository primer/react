  "props": [
    {
      "name": "className",
      "type": "string | ((state: ToggleGroupState) => string | undefined)"
    },
    {
      "name": "fullWidth",
      "type": "ResponsiveValue<boolean>"
    },
    {
      "name": "size",
      "type": "SegmentedControlSize",
      "defaultValue": "'medium'"
    },
    {
      "name": "variant",
      "type": "\"default\" | Partial<Record<\"narrow\" | \"regular\" | \"wide\", SegmentedControlVariant>>",
      "defaultValue": "'default'"
    }
  ],
  "subcomponents": [
    {
      "name": "Button",
      "props": [
        {
          "name": "children",
          "type": "React.ReactElement[]"
        },
        {
          "name": "className",
          "type": "string | ((state: ToggleState) => string | undefined)"
        },
        {
          "name": "count",
          "type": "string | number"
        },
        {
          "name": "leadingVisual",
          "type": "React.ReactNode"
        },
        {
          "name": "value",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "IconButton",
      "props": [
        {
          "name": "aria-label",
          "type": "string",
          "required": true,
          "description": "Defines a string value that labels the current element."
        },
        {
          "name": "className",
          "type": "string | ((state: ToggleState) => string | undefined)"
        },
        {
          "name": "count",
          "type": "string | number"
        },
        {
          "name": "icon",
          "type": "React.ElementType",
          "required": true
        },
        {
          "name": "value",
          "type": "string",
          "required": true
        }
      ]
    }
  ]
}
