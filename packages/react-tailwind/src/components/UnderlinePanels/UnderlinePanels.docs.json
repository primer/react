    },
    {
      "id": "react-tailwind-navigation-underlinepanels-features--with-icons"
    },
    {
      "id": "react-tailwind-navigation-underlinepanels-features--with-icons-hidden-on-narrow-screen"
    },
    {
      "id": "react-tailwind-navigation-underlinepanels-features--with-counters"
    },
    {
      "id": "react-tailwind-navigation-underlinepanels-features--with-counters-in-loading-state"
