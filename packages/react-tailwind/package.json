{
  "name": "@primer/react-tailwind",
  "version": "0.0.0",
  "description": "Primer React components built with Tailwind CSS and Base UI",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./base.css": "./dist/base.css",
    "./components.css": "./dist/components.css",
    "./api-inventory.json": "./api-inventory.json",
    "./llms.txt": "./llms.txt",
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "api-inventory.json",
    "README.md",
    "ARCHITECTURE.md",
    "llms.txt",
    "AGENTS.md",
    "api-inventory.schema.json"
  ],
  "sideEffects": [
    "./dist/**/*.css"
  ],
  "scripts": {
    "build": "npm run clean && rolldown -c && npm run build:css && npm run build:llms",
    "build:css": "tailwindcss -i ./src/styles/styles.css -o ./dist/styles.css --minify && node ./script/copy-css.mjs",
    "build:css:storybook": "npm run build:css && tailwindcss -i ./src/styles/storybook.css -o ./.storybook/styles.css --minify",
    "build:llms": "node ./script/generate-llms-txt.mjs",
    "check:exports": "node ./script/check-built-exports.mjs",
    "check:inventory": "node ./script/check-api-inventory.mjs",
    "check:llms": "node ./script/check-llms-txt.mjs",
    "check:packed-consumer": "npm run check:exports && node ./script/check-packed-consumer.mjs",
    "clean": "rimraf dist",
    "lint:client-boundaries": "node ./script/lint-client-boundaries.mjs",
    "lint:npm": "publint --types",
    "lint:react-compiler": "node ./script/lint-react-compiler.mjs",
    "test": "vitest --run -c vitest.config.mts",
    "type-check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/primer/react.git"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "primer",
    "tailwind",
    "base-ui"
  ],
  "author": "GitHub, Inc.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@github/relative-time-element": "^5.3.0",
    "@primer/octicons-react": "^19.28.1",
    "@primer/primitives": "10.x || 11.x",
    "@primer/tailwind-config": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "color2k": "^2.0.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@primer/react-compiler-check": "^0.0.0",
    "@primer/vitest-config": "^0.0.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@storybook/react-vite": "^10.5.0",
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "ajv": "^8.18.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "fast-glob": "^3.3.3",
    "jsdom": "^27.4.0",
    "publint": "^0.3.15",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rimraf": "^6.0.1",
    "rolldown": "^1.1.4",
    "rolldown-plugin-dts": "^0.26.0",
    "rolldown-plugin-preserve-directives": "^0.0.0",
    "storybook": "^10.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@types/react": "19.x",
    "@types/react-dom": "19.x",
    "react": "19.x",
    "react-dom": "19.x"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  }
}
